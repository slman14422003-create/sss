<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Messaging" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- ألوان التطبيق -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primaryVariant</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/secondary</item>

        <!-- خلفية عامة -->
        <item name="android:windowBackground">@color/background</item>

        <!-- تعديل شكل الـ EditText ليشبه iOS -->
        <item name="android:editTextStyle">@style/Widget.App.EditText.Ios</item>
    </style>

    <style name="Widget.App.EditText.Ios" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:background">@null</item>
        <item name="android:padding">0dp</item>
    </style>
</resources>
